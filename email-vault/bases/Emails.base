filters:
  and:
    - file.inFolder("raw/emails")
    - type == "email"
formulas:
  subject_link: file.asLink(if(subject.isEmpty(), file.basename, subject))
properties:
  note.from:
    displayName: From
  formula.subject_link:
    displayName: Subject
  note.date:
    displayName: Date
  note.has_attachments:
    displayName: Att.
  note.wiki_status:
    displayName: Wiki
views:
  - type: table
    name: Last 14 days
    filters:
      and:
        - date > now() - "14 days"
    order:
      - date
      - from
      - formula.subject_link
      - has_attachments
      - wiki_status
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Not yet compiled
    filters:
      and:
        - wiki_status == "pending"
    order:
      - date
      - from
      - formula.subject_link
    sort:
      - property: date
        direction: ASC
  - type: table
    name: High importance
    filters:
      and:
        - importance == "high"
    order:
      - date
      - from
      - formula.subject_link
    sort:
      - property: date
        direction: DESC
  - type: table
    name: With attachments
    filters:
      and:
        - has_attachments == true
    order:
      - date
      - from
      - formula.subject_link
    sort:
      - property: date
        direction: DESC
