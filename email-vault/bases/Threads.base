filters:
  and:
    - file.inFolder("wiki/threads")
    - type == "thread"
formulas:
  actionable: status == "open" || status == "waiting"
properties:
  note.next_action:
    displayName: Next action
  note.last_activity:
    displayName: Last activity
views:
  - type: table
    name: I owe
    filters:
      and:
        - status == "open"
        - owner == "me" || owner.isEmpty()
    order:
      - file.name
      - next_action
      - due
      - last_activity
      - participants
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Team owes
    filters:
      and:
        - status == "open"
        - owner != "me"
        - "!owner.isEmpty()"
    order:
      - file.name
      - owner
      - next_action
      - due
      - last_activity
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Waiting on others
    filters:
      and:
        - status == "waiting"
    order:
      - file.name
      - owner
      - next_action
      - due
      - last_activity
    sort:
      - property: last_activity
        direction: ASC
  - type: table
    name: Overdue
    filters:
      and:
        - formula.actionable
        - due < today()
    order:
      - file.name
      - status
      - due
      - next_action
  - type: table
    name: Due this week
    filters:
      and:
        - formula.actionable
        - due >= today()
        - due <= today() + "7d"
    order:
      - file.name
      - status
      - owner
      - next_action
      - due
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Nudge
    filters:
      and:
        - status == "waiting"
        - last_activity < today() - "7d"
    order:
      - file.name
      - owner
      - next_action
      - last_activity
      - due
    sort:
      - property: last_activity
        direction: ASC
  - type: table
    name: By project
    filters:
      and:
        - formula.actionable
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - status
      - next_action
      - due
  - type: table
    name: All threads
    order:
      - file.name
      - status
      - project
      - last_activity
    sort:
      - property: last_activity
        direction: DESC
