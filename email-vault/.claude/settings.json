{
  "permissions": {
    "allow": [
      "Bash(uv run --frozen python .claude/skills/email-ingest/scripts/pending.py)",
      "Bash(uv run --frozen python .claude/skills/email-ingest/scripts/pending.py stats)",
      "Bash(uv run --frozen python .claude/skills/email-ingest/scripts/pending.py --json)",
      "Bash(uv run --frozen python .claude/skills/email-ingest/scripts/lint_vault.py)",
      "Bash(uv run --frozen python .claude/skills/email-ingest/scripts/lint_vault.py *)",
      "Bash(.venv/Scripts/python.exe .claude/skills/email-ingest/scripts/pending.py)",
      "Bash(.venv/Scripts/python.exe .claude/skills/email-ingest/scripts/pending.py stats)",
      "Bash(.venv/Scripts/python.exe .claude/skills/email-ingest/scripts/pending.py --json)",
      "Bash(.venv/Scripts/python.exe .claude/skills/email-ingest/scripts/lint_vault.py)",
      "Bash(.venv/Scripts/python.exe .claude/skills/email-ingest/scripts/lint_vault.py *)",
      "Bash(.venv/bin/python .claude/skills/email-ingest/scripts/pending.py)",
      "Bash(.venv/bin/python .claude/skills/email-ingest/scripts/pending.py stats)",
      "Bash(.venv/bin/python .claude/skills/email-ingest/scripts/pending.py --json)",
      "Bash(.venv/bin/python .claude/skills/email-ingest/scripts/lint_vault.py)",
      "Bash(.venv/bin/python .claude/skills/email-ingest/scripts/lint_vault.py *)",
      "Bash(uv run --frozen ruff check)",
      "Bash(uv run --frozen ruff check .)"
    ],
    "deny": [
      "Edit(raw/**)",
      "Write(raw/**)",
      "Edit(**/raw/**)",
      "Write(**/raw/**)",
      "Bash(*email-ingest/scripts/*--vault*)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest*)",
      "Bash(iwr *)",
      "Bash(Invoke-RestMethod*)",
      "Bash(irm *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(iwr *)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(irm *)",
      "Bash(pip *)",
      "Bash(uv add*)",
      "Bash(uv pip*)",
      "Bash(obsidian eval*)",
      "Bash(obsidian * eval*)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude-in-chrome"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen python .claude/hooks/ruff_check.py"
          }
        ]
      }
    ]
  }
}
