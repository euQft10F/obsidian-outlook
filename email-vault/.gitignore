.venv/
__pycache__/
.obsidian/workspace*.json
.obsidian/cache
.obsidian/*
# Raw email content (bodies, attachments, originals, index/log) is corporate data: never commit it.
# Consequence: wiki links to raw notes won't resolve in a fresh clone.
raw/

tools/*.txt
# Everything under wiki/ (pages, index.md, log.md) is derived from email content: commit only the
# empty folder markers. A fresh clone starts with an empty wiki; the first ingest recreates index/log.
wiki/*
!wiki/*/
wiki/*/*
!wiki/*/.gitkeep

# The inbox holds the .msg/.eml files themselves (and _failed/ tracebacks).
00-inbox/*
!00-inbox/.gitkeep

.idea/
.ruff_cache/
.pytest_cache/
